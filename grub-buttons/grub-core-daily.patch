 static void
+update_block_bounds (list_impl_t self)
+{
+  grub_gfxmenu_view_t view = self->view;
+  if (self->item_block_center && view && view->menu && self->layout_bounds.width
+      && self->layout_bounds.height && check_boxes (self))
+    {
+      grub_menu_entry_t entry;
+      int width = 0, shown, count, height;
+      grub_gfxmenu_box_t box = self->menu_box;
+      grub_gfxmenu_box_t item = self->item_box, sel = self->selected_item_box;
+      self->bounds = self->layout_bounds;
+      for (entry = view->menu->entry_list; entry; entry = entry->next)
+        {
+          width = grub_max (width, grub_font_get_string_width (self->item_font, entry->title));
+          width = grub_max (width, grub_font_get_string_width (self->selected_item_font, entry->title));
+        }
+      width += box->get_left_pad (box) + box->get_right_pad (box)
+               + grub_max (item->get_left_pad (item), sel->get_left_pad (sel))
+               + grub_max (item->get_right_pad (item), sel->get_right_pad (sel))
+               + 2 * self->item_padding + self->icon_width + self->item_icon_space;
+      shown = get_num_shown_items (self);
+      count = grub_min (view->menu->size, grub_max (1, shown));
+      height = count * self->item_height + grub_max (0, count - 1) * self->item_spacing
+               + 2 * self->item_padding + box->get_top_pad (box) + box->get_bottom_pad (box)
+               + grub_max (item->get_top_pad (item), sel->get_top_pad (sel))
+               + grub_max (item->get_bottom_pad (item), sel->get_bottom_pad (sel));
+      if (self->draw_scrollbar && shown < view->menu->size)
+        width += self->scrollbar_width + self->scrollbar_left_pad + self->scrollbar_right_pad;
+      else
+        width += self->scrollbar_left_pad;
+      self->bounds.width = grub_min ((int) self->layout_bounds.width, width);
+      self->bounds.height = grub_min ((int) self->layout_bounds.height, height);
+      self->bounds.x = self->layout_bounds.x + (self->layout_bounds.width - self->bounds.width) / 2;
+      self->bounds.y = self->layout_bounds.y + (self->layout_bounds.height - self->bounds.height) / 2;
+    }
+}
