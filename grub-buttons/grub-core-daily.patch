+/* The owner's signed daily image contains its original decoded artwork as
+ * one bounded RGB stream. gzip is handled by GRUB's existing file filter.
+ * This avoids per-pixel JPEG/PNG decoding in the first interactive frame.
+ * Other themes and file types continue to use the standard readers. */
+static grub_err_t
+d1_load_background (struct grub_video_bitmap **bitmap, const char *path)
+{
+  grub_file_t file;
+  grub_uint8_t header[16];
+  const grub_size_t pixels = 1920U * 1080U * 4U;
+  grub_err_t error;
+  file = grub_file_open (path, GRUB_FILE_TYPE_PIXMAP);
+  if (!file) return grub_errno;
+  if (file->size != sizeof (header) + pixels
+      || grub_file_read (file, header, sizeof (header)) != sizeof (header)
+      || grub_memcmp (header, "SP8BG001\200\007\000\000\070\004\000\000", sizeof (header)))
+    {
+      grub_file_close (file);
+      return grub_error (GRUB_ERR_BAD_FILE_TYPE, "D1 signed background header/size refused");
+    }
+  error = grub_video_bitmap_create (bitmap, 1920, 1080, GRUB_VIDEO_BLIT_FORMAT_RGBA_8888);
+  if (!error)
+    {
+      grub_size_t done;
+      for (done = 0; done < pixels; done += 65536)
+        {
+          grub_size_t count = grub_min ((grub_size_t) 65536, pixels - done);
+          grub_term_poll_input ();
+          if (grub_file_read (file, (grub_uint8_t *) (*bitmap)->data + done, count) != (grub_ssize_t) count)
+            {
+              grub_video_bitmap_destroy (*bitmap); *bitmap = 0;
+              error = grub_error (GRUB_ERR_FILE_READ_ERROR, "D1 background read failed");
+              break;
+            }
+        }
+    }
+  grub_file_close (file);
+  return error;
+}
+
+static grub_err_t
+d1_load_native_background (struct grub_video_bitmap **bitmap, const char *path)
+{
+  grub_file_t file;
+  grub_uint8_t header[24], *buffer;
+  grub_uint32_t runs;
+  grub_size_t done = 0, bytes, left;
+  grub_err_t error;
+  const grub_size_t pixels = 2880U * 1920U;
+  *bitmap = NULL;
+  file = grub_file_open (path, GRUB_FILE_TYPE_PIXMAP);
+  if (!file) return grub_errno;
+  if (grub_file_read (file, header, sizeof (header)) != sizeof (header)
+      || grub_memcmp (header, "SP8RLE01", 8)
+      || d1_rle_u32 (header + 8) != 2880 || d1_rle_u32 (header + 12) != 1920
+      || d1_rle_u32 (header + 20) != 0
+      || !(runs = d1_rle_u32 (header + 16)) || runs > pixels
+      || file->size != sizeof (header) + (grub_uint64_t) runs * 8)
+    {
+      grub_file_close (file);
+      return grub_error (GRUB_ERR_BAD_FILE_TYPE, "D1 native background header/size refused");
+    }
+  buffer = grub_malloc (32768);
+  if (!buffer) { grub_file_close (file); return grub_errno; }
+  error = grub_video_bitmap_create (bitmap, 2880, 1920, GRUB_VIDEO_BLIT_FORMAT_RGBA_8888);
+  if (!error)
+    {
+      for (left = (grub_size_t) runs * 8; left; left -= bytes)
+        {
+          bytes = grub_min (left, (grub_size_t) 32768);
+          grub_term_poll_input ();
+          if (grub_file_read (file, buffer, bytes) != (grub_ssize_t) bytes
+              || !d1_expand_background_runs (buffer, bytes, (*bitmap)->data,
+                                             pixels, &done, grub_term_poll_input))
+            {
+              error = grub_error (GRUB_ERR_BAD_FILE_TYPE, "D1 native background run/length refused");
+              break;
+            }
+        }
+      if (!error && done != pixels)
+        error = grub_error (GRUB_ERR_BAD_FILE_TYPE, "D1 native background pixels incomplete");
+    }
+  if (error) { grub_video_bitmap_destroy (*bitmap); *bitmap = NULL; }
+  grub_free (buffer); grub_file_close (file);
+  return error;
+}
 
