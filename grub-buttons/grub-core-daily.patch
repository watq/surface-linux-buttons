+      self->bounds.width = grub_min ((int) self->layout_bounds.width, width);
+      self->bounds.height = grub_min ((int) self->layout_bounds.height, height);
+      self->bounds.x = self->layout_bounds.x + (self->layout_bounds.width - self->bounds.width) / 2;
+      self->bounds.y = self->layout_bounds.y + (self->layout_bounds.height - self->bounds.height) / 2;
