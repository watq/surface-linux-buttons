+  grub_uint64_t begin;
+  if (!grub_env_get ("sp8_daily_active") || !event) return 1;
+  begin = grub_get_time_ms ();
+  status = grub_efi_system_table->boot_services->check_event (event);
+  d1_console_timing ("CheckEvent", begin, status);
